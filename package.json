{
  "name": "vrcx-web-server",
  "version": "1.0.0",
  "description": "Web server that exposes the VRCX SQLite database as a read-only API",
  "homepage": "https://github.com/tomacheese/vrcx-web-server",
  "bugs": {
    "url": "https://github.com/tomacheese/vrcx-web-server/issues"
  },
  "license": "MIT",
  "author": "Tomachi <tomachi@tomacheese.com>",
  "private": true,
  "main": "index.js",
  "repository": {
    "url": "git@github.com:tomacheese/vrcx-web-server.git",
    "type": "git"
  },
  "scripts": {
    "start": "tsx ./src/main.ts",
    "dev": "tsx watch ./src/main.ts",
    "build": "tsc -p tsconfig.json",
    "lint:prettier": "prettier --check src",
    "lint:tsc": "tsc",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "fix:prettier": "prettier --write src",
    "preinstall": "npx only-allow pnpm",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "fix": "run-z fix:prettier,fix:eslint"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.124",
    "@book000/node-utils": "1.26.31",
    "@fastify/cors": "11.4.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "better-sqlite3": "13.2.0",
    "eslint": "10.15.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "fastify": "5.12.8",
    "prettier": "3.10.1",
    "run-z": "2.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
